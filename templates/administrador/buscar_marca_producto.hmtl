{% extends 'index.html' %}

{% block title %}Buscar Marca de Producto | Administrador{% endblock title %}

{% block codigoDinamico %}
<main class="flex-1 flex flex-col relative w-full pt-14 pb-20 bg-surface">
  <div class="px-margin pt-space-md pb-space-lg flex flex-col gap-space-md">
    <div>
      <span class="font-label-sm text-label-sm text-secondary tracking-widest uppercase block mb-0.5">Búsqueda Filtrada</span>
      <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Buscar Productos por Marca</h2>
    </div>

    <!-- Formulario de Búsqueda -->
    <form method="get" class="flex gap-space-xs">
      <input type="text" name="marca" placeholder="Ingrese marca del producto..." class="flex-1 h-12 px-space-md bg-surface-container-lowest border border-outline-variant rounded-full text-body-md text-primary focus:outline-none focus:border-secondary transition-colors shadow-sm">
      <button type="submit" class="h-12 px-space-lg bg-primary-container text-on-primary font-label-lg rounded-full hover:bg-secondary transition-colors shadow-sm flex items-center gap-space-xs">
        <span class="material-symbols-outlined text-[20px]">search</span>
        <span>Buscar</span>
      </button>
    </form>

    <!-- Resultados -->
    <div class="bg-surface-container-lowest p-space-md rounded-full shadow-sm overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-outline-variant font-label-md text-label-md text-on-surface-variant uppercase">
            <th class="py-2 px-3">ID</th>
            <th class="py-2 px-3">Nombre</th>
            <th class="py-2 px-3">Marca</th>
          </tr>
        </thead>
        <tbody class="font-body-md text-body-md text-primary divide-y divide-surface-container-low">
          {% for p in resultados %}
          <tr>
            <td class="py-3 px-3 font-semibold">{{ p.id }}</td>
            <td class="py-3 px-3">{{ p.nombre_producto }}</td>
            <td class="py-3 px-3">{{ p.marca_producto }}</td>
          </tr>
          {% empty %}
          <tr>
            <td colspan="3" class="py-4 px-3 text-center text-on-surface-variant">Realice una búsqueda o no se encontraron coincidencias.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</main>
{% endblock codigoDinamico %}